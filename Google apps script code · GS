/**
 * SETUP:
 * 1. Open (or create) the Google Sheet you want entries saved into.
 * 2. Extensions → Apps Script. Delete any starter code, paste this in.
 * 3. Click "Deploy" → "New deployment" → type: "Web app".
 *    - Execute as: Me
 *    - Who has access: Anyone
 * 4. Deploy, authorize when prompted, and copy the Web App URL it gives you
 *    (ends in /exec). This is already wired into script.js.
 *
 * The first row of your sheet should have these headers (in this order),
 * or just leave the sheet empty and this script will add them for you:
 * Timestamp | Full Name | WhatsApp | Brand | Email | UID
 *
 * NOTE: if you already ran an older version of this form (the one with an
 * "Order Amount" field), your sheet's header row still has that extra
 * column from before. Either delete that column from row 1, or just clear
 * the whole sheet — new entries will re-add the correct headers on the
 * next submission since the header row only gets written when the sheet
 * is completely empty.
 */

function doPost(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();

  if (sheet.getLastRow() === 0) {
    sheet.appendRow(["Timestamp", "Full Name", "WhatsApp", "Brand", "Email", "UID"]);
  }

  const p = e.parameter;
  sheet.appendRow([
    p.submittedAt || new Date().toISOString(),
    p.fullName || "",
    p.whatsapp || "",
    p.brand || "",
    p.email || "",
    p.uid || ""
  ]);

  return ContentService.createTextOutput(JSON.stringify({ status: "ok" }))
    .setMimeType(ContentService.MimeType.JSON);
}
